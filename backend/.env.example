# =============================================================================
# Backend environment variables — copy to .env.local and fill in real values.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (Real-time WebRTC Transport & SIP Telephony)
# Get credentials from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# LiveKit SIP Outbound Telephony (Day 6 - Linphone or Twilio Outbound Trunk)
# Get Outbound Trunk ID from https://cloud.livekit.io/ → SIP → Outbound Trunks
# (Required for dialing real phone numbers / Linphone SIP; optional for --simulate)
# -----------------------------------------------------------------------------
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_your_outbound_trunk_id_here
# Backward-compatible alias:
# SIP_OUTBOUND_TRUNK_ID=ST_your_outbound_trunk_id_here

# -----------------------------------------------------------------------------
# Murf (TTS — Text-to-Speech: Murf Falcon)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text: Nova-3 Multilingual)
# Get your API key from https://deepgram.com
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -----------------------------------------------------------------------------
# LLM (Language Model)
# -----------------------------------------------------------------------------
# For Gemini (default): get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_api_key_here

# For OpenAI (alternative): get from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# -----------------------------------------------------------------------------
# Escalation Email / SMTP (Day 7 — Human Escalation Service)
# Configure SMTP settings to send escalation notifications to human support
# -----------------------------------------------------------------------------
ESCALATION_EMAIL_TO=
ESCALATION_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
